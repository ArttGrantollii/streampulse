# StreamPulse local configuration.
# Copy to .env (`make up` does this automatically on first run) and adjust.
# .env is gitignored; never commit real credentials. These defaults are for
# a local, localhost-only development stack.

# Compose project name (prefixes container, volume and network names).
COMPOSE_PROJECT_NAME=streampulse

# --- Kafka (single-node KRaft) ---------------------------------------------
# Identifies the KRaft cluster; the storage directory is formatted with it on
# first start. Generate a new one with:
#   docker run --rm apache/kafka:4.2.2 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=2IrADSY-TR-BUmu0dKO6Og
# Host port for clients running outside Docker (e.g. the producer during development).
KAFKA_HOST_PORT=9094

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=streampulse
POSTGRES_USER=streampulse
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST_PORT=5432

# --- Flink -------------------------------------------------------------------
FLINK_UI_HOST_PORT=8081

# --- Build tooling -------------------------------------------------------------
# The Maven build container runs as this user so build output (flink-jobs/target, dist)
# is owned by you, not root. `make` sets these from `id -u` / `id -g`.
HOST_UID=1000
HOST_GID=1000

# Producer local metrics port
PRODUCER_METRICS_HOST_PORT=8000
