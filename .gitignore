# Secrets: never commit. .env.example documents the variables.
.env
.env.*
!.env.example

# Recordings and large data (commit only small fixtures under sample-data/fixtures/)
*.ndjson
!sample-data/fixtures/*.ndjson
recordings/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/

# Java / Maven (flink-jobs/dist is kept via .gitkeep; built jars are not committed)
target/
flink-jobs/dist/*.jar
*.class
dependency-reduced-pom.xml

# Editors and OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Local Maven repository used by the containerised build
flink-jobs/.m2/
